# Cross toolchain: host clang/lld -> $ARCH (aarch64 or x86_64), Debian bullseye sysroot
# (glibc 2.31, libstdc++ from GCC 10). Deps prefix: ~/kfx-build/$ARCH/prefix.
set(KFX_ARCH $ENV{ARCH})
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR ${KFX_ARCH})
if(KFX_ARCH STREQUAL "x86_64")
  set(CMAKE_SYSROOT $ENV{HOME}/chroot-bullseye-amd64)
  set(KFX_MARCH "-march=x86-64")
else()
  set(CMAKE_SYSROOT $ENV{HOME}/chroot-bullseye)
  set(KFX_MARCH "-march=armv8-a")
endif()
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET ${KFX_ARCH}-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET ${KFX_ARCH}-linux-gnu)
set(CMAKE_C_FLAGS_INIT "${KFX_MARCH}")
set(CMAKE_CXX_FLAGS_INIT "${KFX_MARCH}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH $ENV{HOME}/kfx-build/${KFX_ARCH}/prefix)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} ${CMAKE_SYSROOT})
set(ENV{PKG_CONFIG_LIBDIR} ${CMAKE_SYSROOT}/usr/lib/${KFX_ARCH}-linux-gnu/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig)
