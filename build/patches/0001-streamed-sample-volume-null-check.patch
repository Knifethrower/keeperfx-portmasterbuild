From the previous port (PieterVdc/keeperfx portmaster branch): don't touch the
streamed sample when sound is disabled or nothing is playing (older SDL_mixer
dereferences a NULL chunk).
--- a/src/bflib_sndlib.cpp
+++ b/src/bflib_sndlib.cpp
@@ -913,6 +913,9 @@ extern "C" void stop_streamed_samples()
 }

 extern "C" void set_streamed_sample_volume(SoundVolume volume) {
+	if (SoundDisabled || g_streamed_sample == nullptr) {
+		return;
+	}
 	// SoundVolume ranges 0..255 but MIX_MAX_VOLUME ranges 0..128
 	Mix_VolumeChunk(g_streamed_sample, volume / 2);
 }
